<UserControl x:Class="Whub.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="Page_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShowIf" />
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28,44,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="344" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Account Manager" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,14,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="SelectAllButton" Style="{StaticResource GhostButton}" Content="All / none" Click="SelectAll_Click" Margin="0,0,6,0" />
                            <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="Add_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="{StaticResource AccentInk}" Margin="0,0,8,0" />
                                    <TextBlock Text="Add account" Foreground="{StaticResource AccentInk}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="TickSummary" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,0,10"
                                      SizeChanged="ListScroll_SizeChanged">
                            <ItemsControl x:Name="AccountList" Margin="10,0"
                                          MouseMove="List_MouseMove" MouseLeftButtonUp="List_MouseUp" LostMouseCapture="List_LostCapture"
                                          Focusable="False" Background="Transparent">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Tile" Height="118" Margin="4" CornerRadius="12" BorderThickness="1"
                                                BorderBrush="Transparent" Background="{StaticResource Raised}"
                                                Cursor="Hand" MouseLeftButtonDown="Tile_MouseDown">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                                    <Grid Width="48" Height="48" Margin="0,0,0,7">
                                                        <Ellipse Fill="{StaticResource RaisedHover}" />
                                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Muted}" />
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Note}" ToolTip="{Binding Note}" Style="{StaticResource Hint}"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                </StackPanel>

                                                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Ticked, Mode=TwoWay}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,9,0,0"
                                                          AutomationProperties.Name="{Binding Name}" />

                                                <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                        ToolTip="Remove" AutomationProperties.Name="Remove account" Click="Remove_Click"
                                                        Opacity="0" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource RaisedHover}" />
                                                <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger SourceName="RemoveButton" Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Ticked}" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentSoft}" />
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Dragging}" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource RaisedHover}" />
                                                <Setter TargetName="Tile" Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="34" Foreground="{StaticResource Faint}" Margin="0,0,0,14" />
                            <TextBlock Text="No accounts yet" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"
                                       Text="Add one by logging in, or bring over the accounts you saved in welffi's macros." />
                            <Button x:Name="ImportButton" Content="Import from macro" HorizontalAlignment="Center" Click="Import_Click" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="Actions">
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Launch" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Runs for every ticked account." Style="{StaticResource Hint}" Margin="0,2,0,12" />
                            <TextBox x:Name="FollowBox" Tag="Player to follow (optional)" MaxLength="20" AutomationProperties.Name="Player to follow" Margin="0,0,0,8" />
                            <UniformGrid Rows="1" Margin="-3,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Open / follow" Margin="3,0" Click="Open_Click" />
                                <Button Content="Join most recent" Margin="3,0" Click="JoinRecent_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Private servers" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <TextBox x:Name="LinkBox" Tag="Paste a private server link" AutomationProperties.Name="Private server link" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Join" Width="66" Margin="6,0,0,0" Click="JoinLink_Click" />
                                <Button DockPanel.Dock="Right" Content="Save" Width="60" Margin="6,0,0,0" Click="SaveServer_Click" />
                                <TextBox x:Name="ServerNameBox" Tag="Name to save it as" MaxLength="40" AutomationProperties.Name="Server name" />
                            </DockPanel>
                            <ItemsControl x:Name="ServerList" Focusable="False" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Height="38">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete"
                                                    AutomationProperties.Name="Delete server" Click="DeleteServer_Click" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Join"
                                                    AutomationProperties.Name="Join server" Click="JoinServer_Click" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Windows" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="SwitchKeyButton" DockPanel.Dock="Right" MinWidth="82" Click="SwitchKey_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Switch key" />
                                    <TextBlock Text="Jumps to the next Roblox window" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <CheckBox x:Name="FastFlagsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          AutomationProperties.Name="Performance FastFlags" Click="FastFlags_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Performance FastFlags" />
                                    <TextBlock Text="Used on the next Roblox launch" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4,12,0,0" Height="20">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource Faint}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="13" Text="Ready" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ConfirmLayer" Background="#B30A0B0D" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="380" Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmBody" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancel" Content="Cancel" Margin="0,0,8,0" Click="ConfirmCancel_Click" />
                        <Button Content="Remove" Style="{StaticResource PrimaryButton}" Click="ConfirmAccept_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
