<UserControl x:Class="Whub.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,48,36,32" MaxWidth="980">
            <TextBlock x:Name="Greeting" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="DateLine" Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,28" />

            <UniformGrid Rows="1" Margin="-6,0,-6,32">
                <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                    <StackPanel>
                        <TextBlock x:Name="AccountCount" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Accounts" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                    <StackPanel>
                        <TextBlock x:Name="ServerCount" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Private servers" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                    <StackPanel>
                        <TextBlock x:Name="WindowCount" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Text="Roblox windows open" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Tools" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
            <UniformGrid x:Name="ToolGrid" Columns="2" Margin="-6,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
