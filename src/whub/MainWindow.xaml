<Window x:Class="Whub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="welffi hub"
        Width="1140" Height="740" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ink}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource Ink}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="4,10,0,18">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="w" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17"
                                   Foreground="{StaticResource AccentInk}" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>
                    <TextBlock Text="welffi hub" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="16"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel x:Name="Nav" WindowChrome.IsHitTestVisibleInChrome="True" />
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
        </StackPanel>
    </Grid>
</Window>
